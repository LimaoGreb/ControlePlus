{
  "expo": {
    "name": "Controle+",
    "slug": "FinanceApp",
    "scheme": "br.kowalsky.financeapp",
    "version": "2.14.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A38"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.kowalsky.financeapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "br.kowalsky.financeapp",
      "versionCode": 43,
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Controle+ usa suas fotos para definir sua imagem de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E0A52E"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Cap precisa do microfone para ouvir você.",
          "speechRecognitionPermission": "O Cap precisa reconhecer sua voz para responder.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "59994d16-92d2-439e-b416-f9ace5a353ed"
      }
    }
  }
}
