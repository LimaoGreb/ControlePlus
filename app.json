{
  "expo": {
    "name": "Controle+",
    "slug": "FinanceApp",
    "scheme": "br.kowalsky.financeapp",
    "version": "2.30.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A38"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.kowalsky.financeapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "br.kowalsky.financeapp",
      "versionCode": 47,
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "react-native-android-widget",
        {
          "fonts": [],
          "widgets": [
            {
              "name": "SaldoWidget",
              "label": "Controle+ · Saldo do Mês",
              "description": "Mostra a sobra do mês atual com barra de gastos.",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "none",
              "widgetCategory": "home_screen"
            },
            {
              "name": "ResumoWidget",
              "label": "Controle+ · Resumo Financeiro",
              "description": "Renda, gastos e sobra do mês com barra de progresso.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal",
              "widgetCategory": "home_screen"
            },
            {
              "name": "LancamentoWidget",
              "label": "Controle+ · Lançamento Rápido",
              "description": "Abre o app direto no lançamento.",
              "minWidth": "180dp",
              "minHeight": "74dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "updatePeriodMillis": 0,
              "resizeMode": "none",
              "widgetCategory": "home_screen"
            },
            {
              "name": "PortfolioWidget",
              "label": "Controle+ · Portfólio",
              "description": "Resumo dos seus investimentos.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal",
              "widgetCategory": "home_screen"
            },
            {
              "name": "ProjetoWidget",
              "label": "Controle+ · Projeto",
              "description": "Progresso do seu projeto de poupança.",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "none",
              "widgetCategory": "home_screen"
            },
            {
              "name": "CartoesWidget",
              "label": "Controle+ · Cartões",
              "description": "Limites disponíveis dos seus cartões de crédito.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal",
              "widgetCategory": "home_screen"
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Controle+ usa suas fotos para definir sua imagem de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E0A52E"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Cap precisa do microfone para ouvir você.",
          "speechRecognitionPermission": "O Cap precisa reconhecer sua voz para responder.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "59994d16-92d2-439e-b416-f9ace5a353ed"
      }
    }
  }
}
