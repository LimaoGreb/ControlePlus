{
  "expo": {
    "name": "Controle+",
    "slug": "FinanceApp",
    "scheme": "com.mautic.financeapp",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A38"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mautic.financeapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.mautic.financeapp",
      "versionCode": 18,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.198101730282-r33arkuqt67oqg5ptn47lttjcckvnt66"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Controle+ usa suas fotos para definir sua imagem de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E0A52E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "59994d16-92d2-439e-b416-f9ace5a353ed"
      }
    }
  }
}
